}

.card p {
  font-size: 12px;
  color: #68738a;
  line-height: 1.5;
}

.price {
  font-weight: bold;
  color: #e65b00;
  font-size: 16px;
  margin: 10px 0;
}

.buy {
  display: block;
  text-decoration: none;
  background: #ffb800;
  color: #172033;
  text-align: center;
  padding: 11px 5px;
  border-radius: 8px;
  font-weight: bold;
  font-size: 13px;
}

.notice {
  background: white;
  margin: 0 12px 20px;
  padding: 15px;
  border-radius: 12px;
  font-size: 13px;
  line-height: 1.8;
}

footer {
  background: #101b36;
  color: white;
  text-align: center;
  padding: 24px 12px;
  font-size: 13px;
  line-height: 1.9;
}

footer a {
  color: #ffcf45;
}

.empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: 30px 10px;
}

</style>
</head>

