  color: #ffb800;
}

header p {
  margin-top: 7px;
  font-size: 13px;
}

.search {
  padding: 15px;
  background: white;
}

.search input {
  width: 100%;
  padding: 13px;
  border: 1px solid #ddd;
  border-radius: 10px;
  font-size: 15px;
}

.hero {
  margin: 15px;
  padding: 28px 18px;
  border-radius: 15px;
  background: linear-gradient(135deg, #101b36, #1769e0);
  color: white;
